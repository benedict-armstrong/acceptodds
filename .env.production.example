# Production keys, no values. Copy to .env.production on the host and fill it.
# .env.production is NEVER committed.

# --- database -------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- app ------------------------------------------------------------------
NODE_ENV=
APP_URL=
# The label on the embeddable badge (/badge/<slug>.svg) and og:site_name.
SITE_NAME=acceptodds
STARTING_BALANCE_MICRO=
# Per-token API rate limit (token bucket in Postgres): burst size, refill/sec.
API_RATE_LIMIT_BURST=
API_RATE_LIMIT_PER_SECOND=

# --- auth ------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- email ----------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# --- sign-up allowlist -----------------------------------------------------
# Optional; defaults to config/institution-domains.json in the image.
INSTITUTION_DOMAINS_PATH=

# --- admins ----------------------------------------------------------------
# Comma-separated emails whose sessions get the admin scope.
ADMIN_EMAILS=

# --- UI ---------------------------------------------------------------------
DEFAULT_MARKET_KIND=

# --- analytics --------------------------------------------------------------
# Umami, the host-wide instance in ~/ops. Optional: both set turns the tracker
# on (read per request, so a restart applies it).
UMAMI_URL=https://analytics.acceptodds.com
UMAMI_WEBSITE_ID=

# --- edge -----------------------------------------------------------------
# Traefik's per-IP rate limit on the app (docker-compose.prod.yml): average
# requests/sec and burst.
RATE_LIMIT_AVERAGE=
RATE_LIMIT_BURST=

# Morning digest (`npm run digest:send`, from cron): the smallest move, in
# percentage points over 24h, of a followed paper that is worth an email, and
# the time zone whose calendar day makes it once-a-day.
DIGEST_MIN_MOVE_PP=5
DIGEST_TIMEZONE=Europe/Zurich

# How old the shared net-worth curve (leaderboard, navbar) may get before a
# read refreshes it, in seconds.
FIELD_SNAPSHOT_MAX_AGE_SECONDS=300
