# Production keys, no values. Copy to .env.production on the host and fill it.
# .env.production is NEVER committed.

# --- database -------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- app ------------------------------------------------------------------
NODE_ENV=
APP_URL=
STARTING_BALANCE_MICRO=
# Per-token API rate limit (token bucket in Postgres): burst size, refill/sec.
API_RATE_LIMIT_BURST=
API_RATE_LIMIT_PER_SECOND=

# --- auth ------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- email ----------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# --- institutional verification -------------------------------------------
# Path to the index built by `npm run ror:index`, baked in or mounted.
ROR_INDEX_PATH=

# --- errors ---------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- jobs / edge (not implemented yet) ------------------------------------
CRON_SECRET=
RATE_LIMIT_AVERAGE=
RATE_LIMIT_BURST=
