# Production keys, no values. Copy to .env.production on the host and fill it.
# .env.production is NEVER committed.

# --- database -------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- app ------------------------------------------------------------------
NODE_ENV=
APP_URL=
STARTING_BALANCE_MICRO=
# Per-token API rate limit (token bucket in Postgres): burst size, refill/sec.
API_RATE_LIMIT_BURST=
API_RATE_LIMIT_PER_SECOND=

# --- auth ------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- email ----------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# --- sign-up allowlist -----------------------------------------------------
# Optional; defaults to config/institution-domains.json in the image.
INSTITUTION_DOMAINS_PATH=

# --- admins ----------------------------------------------------------------
# Comma-separated emails whose sessions get the admin scope.
ADMIN_EMAILS=

# --- UI ---------------------------------------------------------------------
DEFAULT_MARKET_KIND=

# --- errors ---------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- jobs / edge (not implemented yet) ------------------------------------
CRON_SECRET=
RATE_LIMIT_AVERAGE=
RATE_LIMIT_BURST=

# Morning digest (`npm run digest:send`, from cron): the smallest move, in
# percentage points over 24h, of a followed paper that is worth an email, and
# the time zone whose calendar day makes it once-a-day.
DIGEST_MIN_MOVE_PP=5
DIGEST_TIMEZONE=Europe/Zurich
