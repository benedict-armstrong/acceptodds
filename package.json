    "token:mint": "tsx scripts/mint-token.ts",
    "api:smoke": "tsx scripts/api-smoke.ts",
    "digest:send": "tsx scripts/send-digest.ts",
    "auth:generate": "auth generate --config auth.config.ts --output src/db/auth-schema.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@better-auth/api-key": "^1.7.6",
