    "@sentry/nextjs": "^11.0.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "katex": "^0.18.9",
    "next": "15.5.26",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
