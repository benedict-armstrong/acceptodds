# Dev environment. Copy to .env and adjust. Never commit a filled file.
# Matches docker-compose.dev.yml.
DATABASE_URL=postgres://papermarket:papermarket@127.0.0.1:55432/papermarket

# Same database, separate name, used by the integration tests. The test suite
# TRUNCATEs tables, so never point this at a database you care about.
TEST_DATABASE_URL=postgres://papermarket:papermarket@127.0.0.1:55432/papermarket_test

# Reputation granted to a new account, in micro-units (1_000_000 = 1 unit).
STARTING_BALANCE_MICRO=1000000000

# Per-token API rate limit: a token bucket of this many requests, refilling at
# this many per second. Anonymous reads are limited at the edge, not here.
API_RATE_LIMIT_BURST=60
API_RATE_LIMIT_PER_SECOND=2

# Better Auth (sign-in). BETTER_AUTH_URL is this app's public origin; session
# cookie writes to /api/v1 must come from it. Any long random string will do
# for the secret in dev: `openssl rand -base64 32`.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# ORCID sign-in is enabled only when both are set (developers.orcid.org).
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Without RESEND_API_KEY, dev mail (verification links, institution codes) is
# printed to the server log instead of sent.
RESEND_API_KEY=
MAIL_FROM=

# Domain -> institution index built by `npm run ror:index` from the ROR dump.
# Without it, institutional verification answers 503.
ROR_INDEX_PATH=
