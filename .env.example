# Dev environment. Copy to .env and adjust. Never commit a filled file.
# Matches docker-compose.dev.yml.
DATABASE_URL=postgres://papermarket:papermarket@127.0.0.1:55432/papermarket

# Same database, separate name, used by the integration tests. The test suite
# TRUNCATEs tables, so never point this at a database you care about.
TEST_DATABASE_URL=postgres://papermarket:papermarket@127.0.0.1:55432/papermarket_test

# Reputation granted to a new account, in micro-units (1_000_000 = 1 unit).
STARTING_BALANCE_MICRO=1000000000

# Per-token API rate limit: a token bucket of this many requests, refilling at
# this many per second. Anonymous reads are limited at the edge, not here.
API_RATE_LIMIT_BURST=60
API_RATE_LIMIT_PER_SECOND=2
# The same for a credential with the `admin` scope (operator-minted; bulk writes).
API_ADMIN_RATE_LIMIT_BURST=600
API_ADMIN_RATE_LIMIT_PER_SECOND=50

# Better Auth (sign-in). BETTER_AUTH_URL is this app's public origin; session
# cookie writes to /api/v1 must come from it. Any long random string will do
# for the secret in dev: `openssl rand -base64 32`.
BETTER_AUTH_URL=http://localhost:3000
# The origin in absolute links (mail, share cards). Defaults to BETTER_AUTH_URL.
APP_URL=
BETTER_AUTH_SECRET=

# Without RESEND_API_KEY, dev mail (verification links, password resets) is
# printed to the server log instead of sent.
RESEND_API_KEY=
MAIL_FROM=

# Sign-up allowlist of institutional email domains. Defaults to
# config/institution-domains.json (generated: `npm run institutions:build`).
INSTITUTION_DOMAINS_PATH=

# Signed-in users with these emails (comma-separated) get the admin scope.
ADMIN_EMAILS=

# The venue (market `kind`) the home page shows first.
DEFAULT_MARKET_KIND=ICLR 2027

# Morning digest (`npm run digest:send`, from cron): the smallest move, in
# percentage points over 24h, of a followed paper that is worth an email, and
# the time zone whose calendar day makes it once-a-day.
DIGEST_MIN_MOVE_PP=5
DIGEST_TIMEZONE=Europe/Zurich

# How old the shared net-worth curve (leaderboard, navbar) may get before a
# read refreshes it, in seconds.
FIELD_SNAPSHOT_MAX_AGE_SECONDS=300

# The label on the embeddable badge (/badge/<slug>.svg) and og:site_name.
SITE_NAME=acceptodds

# Page analytics (Umami, the host-wide instance in ~/ops). Off unless both are
# set; leave them empty in dev. It only counts on APP_URL's host anyway.
UMAMI_URL=
UMAMI_WEBSITE_ID=

# JEV (TypeSafe, via nano-gpt) prices a listing's market when its first trade makes it.
# Without a key every market opens at its template's fallback prior.
NANOGPT_API_KEY=
# JEV_URL=https://nano-gpt.com/api/v1/decisions
# JEV_MODEL=typesafe/jev-1.13
# Mean headline probability for JEV seeds (0.28 = 28%); base rate/fallback stays venue-specific.
JEV_TARGET_MEAN=0.28
